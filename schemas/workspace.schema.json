{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/workspace.schema.json",
  "title": "Storyteller executor workspace configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["data_dir", "executor_id", "agent", "isolation"],
  "properties": {
    "data_dir": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\/]|\\\\)"
    },
    "executor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "agent": {
      "type": "string",
      "enum": ["claude-code", "codex", "generic"]
    },
    "isolation": {
      "type": "string",
      "enum": ["permission", "placement"]
    }
  }
}
