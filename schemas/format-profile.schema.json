{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/format-profile.schema.json",
  "title": "Format profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "unit",
    "unit_mapping",
    "chars_per_event",
    "max_chars_per_task",
    "template",
    "continuation",
    "rules",
    "checks"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "unit": {
      "type": "string",
      "enum": [
        "chapter",
        "scene",
        "slide",
        "prompt",
        "section"
      ]
    },
    "unit_mapping": {
      "type": "string",
      "enum": [
        "structure",
        "scene",
        "per_event",
        "person_and_event",
        "world_cast"
      ]
    },
    "chars_per_event": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "max_chars_per_task": {
      "type": "integer",
      "minimum": 1
    },
    "template": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "continuation": {
      "type": "boolean"
    },
    "submit_checks": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "no_repeated_sentence"
            ]
          },
          {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": false,
            "properties": {
              "no_repeated_sentence": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "exclude_quoted": {
                    "type": "boolean"
                  },
                  "excerpt": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "llm": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "question",
                  "severity"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "event_coverage",
                      "named_actor",
                      "condition_conflict",
                      "replay"
                    ]
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1
                  },
                  "severity": {
                    "enum": [
                      "error",
                      "advisory"
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "replay"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "severity": {
                          "const": "advisory"
                        }
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  }
}
