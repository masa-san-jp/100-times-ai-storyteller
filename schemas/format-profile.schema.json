{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/format-profile.schema.json",
  "title": "Format profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "unit",
    "unit_mapping",
    "chars_per_event",
    "max_chars_per_task",
    "template",
    "continuation",
    "rules",
    "checks"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "unit": {
      "type": "string",
      "enum": ["chapter", "scene", "slide"]
    },
    "unit_mapping": {
      "type": "string",
      "enum": ["structure", "scene", "per_event"]
    },
    "chars_per_event": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "max_chars_per_task": {
      "type": "integer",
      "minimum": 1
    },
    "template": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "continuation": {
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "llm": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
