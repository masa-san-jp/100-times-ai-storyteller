{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/batch-manifest.schema.json",
  "title": "Storyteller batch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "created_at",
    "updated_at",
    "seed",
    "requested",
    "max_created",
    "completed",
    "duplicates",
    "params",
    "runs"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "batch_id": {"type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[0-9a-f]{6}$"},
    "created_at": {"$ref": "#/$defs/utc-timestamp"},
    "updated_at": {"$ref": "#/$defs/utc-timestamp"},
    "seed": {"type": "integer", "minimum": 0},
    "requested": {"type": "integer", "minimum": 1},
    "max_created": {"type": "integer", "minimum": 1},
    "completed": {"type": "integer", "minimum": 0},
    "duplicates": {"type": "integer", "minimum": 0},
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "axis_overrides", "parts", "plot_type"],
      "properties": {
        "preset": {"type": "string", "minLength": 1},
        "axis_overrides": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "parts": {"type": ["integer", "null"]},
        "plot_type": {"type": ["string", "null"]}
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "index", "outcome"],
        "properties": {
          "run_id": {"type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[0-9a-f]{6}$"},
          "index": {"type": "integer", "minimum": 0},
          "outcome": {"enum": ["pending", "accepted", "duplicate"]}
        }
      }
    }
  },
  "$defs": {
    "utc-timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
