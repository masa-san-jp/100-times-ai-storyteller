{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/story/assignment.schema.json",
  "title": "Story pipeline S3 assignment",
  "type": "object",
  "additionalProperties": false,
  "required": ["r", "threads", "cast", "absent_roles", "world", "world_sections", "world_tasks", "world_fact_tasks", "calendar", "character_fact_tasks"],
  "properties": {
    "r": {
      "type": "number"
    },
    "threads": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/thread"}
    },
    "cast": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/character"}
    },
    "absent_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["messenger", "supporter", "adversary"]
      }
    },
    "world": {"$ref": "#/$defs/world"},
    "calendar": {"type": "object", "additionalProperties": false, "required": ["current_year", "name_sound"], "properties": {"current_year": {"type": "integer", "minimum": 1}, "name_sound": {"$ref": "#/$defs/name-sound"}}},
    "world_sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/world-section"}
    },
    "character_fact_tasks": {"type": "array", "items": {"$ref": "#/$defs/character-fact-task"}},
    "world_fact_tasks": {"type": "array", "items": {"$ref": "#/$defs/world-fact-task"}},
    "world_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/world-task"}
    }
  },
  "$defs": {
    "character-fact-task": {"type": "object", "additionalProperties": false, "required": ["key", "label", "element", "id", "person_id"], "properties": {"key": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"}, "label": {"type": "string", "minLength": 1}, "element": {"enum": ["number", "integer", "name", "text", "choice"]}, "unit": {"type": "string", "minLength": 1}, "range": {"type": "object", "minProperties": 1, "additionalProperties": false, "properties": {"min": {"type": "number"}, "max": {"type": "number"}}}, "max_chars": {"type": "integer", "minimum": 1}, "id": {"type": "string", "pattern": "^c[1-9][0-9]*-[a-z][a-z0-9_.]*$"}, "person_id": {"type": "string", "pattern": "^c[1-9][0-9]*$"}, "name_sound": {"$ref": "#/$defs/name-sound"}}, "allOf": [{"if": {"properties": {"element": {"enum": ["number", "integer"]}}}, "then": {"required": ["unit"]}}]},
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:(?:i[0-9]{2,}|t[0-9]+|x[0-9]+)$"},
        "text": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^m[0-9]{3}$"},
        "text": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "enum": ["desire", "fear", "suppression", "conflict", "image", "value", "theme", "mood"]
        }
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "part", "plot_type", "plot_type_name", "events", "structure"],
      "properties": {
        "id": {"type": "string", "pattern": "^t[0-9]{3}$"},
        "kind": {"type": "string", "enum": ["main", "subthread"]},
        "part": {"type": ["integer", "null"], "minimum": 1},
        "plot_type": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "plot_type_name": {"type": "string", "minLength": 1},
        "events": {"type": "integer", "minimum": 3},
        "structure": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
      }
    },
    "character-elements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["want", "ability", "duty", "age", "gender", "species"],
      "properties": {
        "want": {"$ref": "#/$defs/element"},
        "ability": {"$ref": "#/$defs/element"},
        "duty": {"$ref": "#/$defs/element"},
        "age": {"$ref": "#/$defs/element"},
        "gender": {"$ref": "#/$defs/element"},
        "species": {"$ref": "#/$defs/element"},
        "taboo": {"$ref": "#/$defs/element"}
      }
    },
    "name-sound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set_id", "description", "sounds"],
      "properties": {
        "set_id": {"type": "string", "pattern": "^sound-[0-9]{2}$"},
        "description": {"type": "string", "minLength": 1},
        "sounds": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "elements", "name_sound", "role_definition", "plot_context"],
      "allOf": [
        {
          "if": {
            "required": ["role"],
            "properties": {"role": {"const": "protagonist"}}
          },
          "then": {
            "properties": {
              "elements": {"required": ["taboo"]}
            }
          }
        }
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^c[0-9]+$"},
        "role": {"type": "string", "enum": ["protagonist", "messenger", "supporter", "adversary", "bystander"]},
        "elements": {"$ref": "#/$defs/character-elements"},
        "suppressed_self_image": {"$ref": "#/$defs/material"},
        "name_sound": {"$ref": "#/$defs/name-sound"},
        "role_definition": {"$ref": "#/$defs/role-definition"},
        "plot_context": {"$ref": "#/$defs/plot-context"}
      }
    },
    "role-definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "definition"],
      "properties": {
        "id": {"type": "string", "enum": ["protagonist", "messenger", "supporter", "adversary", "bystander"]},
        "name": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1}
      }
    },
    "plot-context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "character_requirements"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "character_requirements": {"type": "string", "minLength": 1}
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["place", "era", "object", "theme"],
      "properties": {
        "place": {"$ref": "#/$defs/element"},
        "era": {"$ref": "#/$defs/element"},
        "object": {"$ref": "#/$defs/element"},
        "theme": {
          "anyOf": [
            {"$ref": "#/$defs/material"},
            {"type": "null"}
          ]
        }
      }
    },
    "world-section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "definition", "viewpoints", "level", "kind", "max_chars", "prerequisites"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "name": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "viewpoints": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "level": {"type": "integer", "minimum": 0, "maximum": 4},
        "kind": {"type": "string", "enum": ["single", "list"]},
        "max_chars": {"type": "integer", "minimum": 1},
        "prerequisites": {
          "type": "array",
          "maxItems": 2,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "uniqueItems": true
        }
      }
    },
    "world-fact-task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "element",
        "section_id",
        "viewpoint",
        "id",
        "item_id",
        "section"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "element": {
          "enum": [
            "number",
            "integer",
            "year",
            "name",
            "text"
          ]
        },
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "viewpoint": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "refers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "$ref": "#/$defs/world-task/properties/section"
        },
        "name_sound": {
          "$ref": "#/$defs/name-sound"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "element": {
                "enum": [
                  "number",
                  "integer"
                ]
              }
            }
          },
          "then": {
            "required": [
              "unit"
            ]
          }
        }
      ]
    },
    "world-task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section_id", "kind", "section", "element_axis", "element"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*-[0-9]+(?:-f[0-9]+)?$"},
        "section_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "kind": {"type": "string", "enum": ["single", "list"]},
        "section": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "definition"],
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
            "name": {"type": "string", "minLength": 1},
            "definition": {"type": "string", "minLength": 1}
          }
        },
        "viewpoint": {"type": "string", "minLength": 1},
        "facet_number": {"type": "integer", "minimum": 1},
        "element_axis": {"type": "string", "enum": ["place", "era", "object"]},
        "element": {"$ref": "#/$defs/element"},
        "name_sound": {"$ref": "#/$defs/name-sound"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "single"}}},
          "then": {
            "required": ["viewpoint", "facet_number"],
            "not": {"required": ["name_sound"]}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "list"}}},
          "then": {
            "required": ["name_sound"],
            "not": {"anyOf": [{"required": ["viewpoint"]}, {"required": ["facet_number"]}]}
          }
        }
      ]
    }
  }
}
