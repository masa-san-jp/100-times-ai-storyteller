{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/tasks/S7.event.schema.json",
  "title": "Story pipeline S7 event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "when",
    "where",
    "who",
    "why",
    "intent",
    "what",
    "result",
    "emotion",
    "foreshadowing",
    "sources"
  ],
  "properties": {
    "when": {"type": "string", "minLength": 1, "maxLength": 120},
    "where": {"type": "string", "minLength": 1, "maxLength": 120},
    "who": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "why": {"type": "string", "minLength": 1, "maxLength": 120},
    "intent": {"type": "string", "minLength": 1, "maxLength": 120},
    "what": {"type": "string", "minLength": 1, "maxLength": 120},
    "result": {"type": "string", "minLength": 1, "maxLength": 120},
    "emotion": {"type": "string", "minLength": 1, "maxLength": 120},
    "foreshadowing": {"type": "string", "maxLength": 120},
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
