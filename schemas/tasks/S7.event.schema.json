{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/tasks/S7.event.schema.json",
  "title": "Story pipeline S7 event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "when",
    "where",
    "who",
    "why",
    "intent",
    "what",
    "result",
    "emotion",
    "foreshadowing"
  ],
  "properties": {
    "when": {
      "type": "string"
    },
    "where": {
      "type": "string"
    },
    "who": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "why": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "what": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "emotion": {
      "type": "string"
    },
    "foreshadowing": {
      "type": "string"
    }
  }
}
