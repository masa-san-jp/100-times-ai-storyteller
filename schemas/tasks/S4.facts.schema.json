{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "facts",
    "glossary",
    "sources"
  ],
  "properties": {
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "year",
          "calendar",
          "count"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "pattern": "\\S"
          },
          "year": {
            "type": "integer"
          },
          "calendar": {
            "type": "string",
            "pattern": "\\S"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "composition": {
            "type": "string",
            "pattern": "\\S"
          },
          "affiliation": {
            "type": "string",
            "pattern": "\\S"
          },
          "cause": {
            "type": "string",
            "pattern": "\\S"
          },
          "result": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "glossary": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reading",
          "kind",
          "definition"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "reading": {
            "type": "string",
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "pattern": "\\S"
          },
          "definition": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
