{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/tasks/S5.intro.schema.json",
  "title": "S5 short character introduction",
  "type": "object",
  "additionalProperties": false,
  "required": ["intro", "sources"],
  "properties": {
    "intro": {"type": "string", "minLength": 1, "maxLength": 50},
    "sources": {"$ref": "#/$defs/sources"}
  },
  "$defs": {
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
