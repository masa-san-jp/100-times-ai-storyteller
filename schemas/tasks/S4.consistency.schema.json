{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/tasks/S4.consistency.schema.json",
  "title": "S4 fact consistency",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer",
    "reason"
  ],
  "properties": {
    "answer": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ]
    },
    "reason": {
      "type": "string"
    }
  }
}
