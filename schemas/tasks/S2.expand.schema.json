{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/tasks/S2.expand.schema.json",
  "title": "S2 element expansion",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "counterpart", "sources"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 40
      }
    },
    "counterpart": {
      "type": "string",
      "minLength": 10,
      "maxLength": 40
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "pattern": "^m[0-9]{3}$"
      }
    }
  }
}
