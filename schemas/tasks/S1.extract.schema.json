{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/tasks/S1.extract.schema.json",
  "title": "S1 extracted material",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "kind"
  ],
  "properties": {
    "text": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "desire",
        "fear",
        "suppression",
        "conflict",
        "image",
        "value",
        "theme",
        "mood"
      ]
    }
  }
}
