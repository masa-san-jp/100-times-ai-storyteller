{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/tasks/S5.inner_conflict.schema.json",
  "title": "S5 character inner conflict",
  "type": "object",
  "additionalProperties": false,
  "required": ["inner_conflict", "sources"],
  "properties": {
    "inner_conflict": {"type": "string"},
    "sources": {"$ref": "#/$defs/sources"}
  },
  "$defs": {
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
