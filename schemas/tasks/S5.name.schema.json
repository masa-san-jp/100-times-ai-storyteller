{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/tasks/S5.name.schema.json",
  "title": "S5 character name",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "reading", "sources"],
  "properties": {
    "name": {"type": "string"},
    "reading": {"type": "string", "pattern": "^[ァ-ヶー・]+$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^sound-[0-9]{2}$"}
    }
  }
}
