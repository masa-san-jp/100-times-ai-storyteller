{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/tables/world_sections.schema.json",
  "title": "World section catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["sections"],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "definition", "viewpoints", "level", "kind", "max_chars", "prerequisites", "fact_schema"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "name": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1},
          "viewpoints": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "level": {"type": "integer", "minimum": 0, "maximum": 4},
          "kind": {"type": "string", "enum": ["single", "list"]},
          "max_chars": {"type": "integer", "minimum": 1},
          "fact_schema": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
          "prerequisites": {
            "type": "array",
            "maxItems": 2,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
