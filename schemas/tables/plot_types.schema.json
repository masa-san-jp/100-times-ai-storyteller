{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/tables/plot_types.schema.json",
  "title": "Story plot types",
  "type": "object",
  "additionalProperties": false,
  "required": ["types"],
  "properties": {
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/type"}
    }
  },
  "$defs": {
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "core", "structure", "required_events"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "core": {"type": "string", "minLength": 1},
        "structure": {"type": "string", "minLength": 1},
        "required_events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "stage"],
            "properties": {
              "description": {"type": "string", "minLength": 1},
              "stage": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
            }
          }
        }
      }
    }
  }
}
