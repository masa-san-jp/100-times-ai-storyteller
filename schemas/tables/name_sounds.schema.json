{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/tables/name_sounds.schema.json",
  "title": "Name sound sets",
  "type": "object",
  "additionalProperties": false,
  "required": ["sets"],
  "properties": {
    "sets": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "sounds"],
        "properties": {
          "id": {"type": "string", "pattern": "^sound-[0-9]{2}$"},
          "description": {"type": "string", "minLength": 1},
          "sounds": {
            "type": "array",
            "minItems": 12,
            "items": {
              "type": "string",
              "pattern": "^(?![ァィゥェォャュョヮッヵヶー・])[ア-ヺ](?:[ァィゥェォャュョヮ])?(?:ー)?$"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
