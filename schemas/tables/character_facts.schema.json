{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timeline_count",
    "facts"
  ],
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "timeline_count": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "element"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "element": {
          "enum": [
            "number",
            "integer",
            "name",
            "text",
            "choice"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "element": {
                "enum": [
                  "number",
                  "integer"
                ]
              }
            }
          },
          "then": {
            "required": [
              "unit"
            ]
          }
        }
      ]
    }
  }
}
