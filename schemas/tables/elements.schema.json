{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/tables/elements.schema.json",
  "title": "Story element table",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
