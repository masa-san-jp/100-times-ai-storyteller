{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-times-ai-storyteller.example/schemas/tables/beats.schema.json",
  "title": "Scene (beat) function catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["beats", "sequence", "short_sequences"],
  "properties": {
    "beats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "definition", "repeatable"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "name": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1},
          "repeatable": {"type": "boolean"}
        }
      }
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "short_sequences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_count", "beats"],
        "properties": {
          "scene_count": {"type": "integer", "minimum": 1},
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
