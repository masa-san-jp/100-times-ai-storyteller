{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyteller CLI status",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs"],
      "properties": {
        "runs": {
          "type": "array",
          "items": {"$ref": "#/$defs/run-summary"}
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "status", "warnings", "tasks"],
      "properties": {
        "run_id": {"type": "string"},
        "status": {"type": "string"},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "tasks": {
          "type": "array",
          "items": {"$ref": "#/$defs/task"}
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "requested",
        "completed",
        "duplicates",
        "created",
        "runs",
        "problem_runs",
        "failed_tasks"
      ],
      "properties": {
        "batch_id": {
          "type": "string"
        },
        "requested": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "created": {
          "type": "integer",
          "minimum": 0
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run-summary"
          }
        },
        "problem_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run_id",
              "status",
              "warnings"
            ],
            "properties": {
              "run_id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "failed_tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run_id",
              "task_id",
              "reason"
            ],
            "properties": {
              "run_id": {
                "type": "string"
              },
              "task_id": {
                "type": "string"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "run-summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "status", "counts"],
      "properties": {
        "run_id": {"type": "string"},
        "status": {"type": "string"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocked", "ready", "claimed", "done", "failed", "skipped"],
          "properties": {
            "blocked": {"type": "integer", "minimum": 0},
            "ready": {"type": "integer", "minimum": 0},
            "claimed": {"type": "integer", "minimum": 0},
            "done": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0},
            "skipped": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "type", "state", "tries", "invalidations", "executor_id", "isolation", "error", "failure_report"],
      "properties": {
        "task_id": {"type": "string"},
        "type": {"type": "string"},
        "state": {"type": "string"},
        "tries": {"type": "integer", "minimum": 0},
        "invalidations": {"type": "integer", "minimum": 0},
        "executor_id": {"type": ["string", "null"]},
        "isolation": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]},
        "failure_report": {"type": ["string", "null"]}
      }
    }
  }
}
